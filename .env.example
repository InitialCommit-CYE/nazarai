# NazarAI environment variables. Copy the relevant block to:
#   frontend/.env.local      (Next.js, local)     and Vercel Project Settings > Environment Variables
#   backend/.env             (FastAPI, local)     and Hugging Face Space Settings > Variables and secrets
# Never commit real values. Only NEXT_PUBLIC_* values are ever sent to the browser.

# ---------------------------------------------------------------- Next.js (Vercel)
# Supabase project URL and PUBLISHABLE key (safe for the browser: sessions, signed uploads and
# Realtime; RLS gives anon nothing and signed-in users only their role/clinic's rows).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000       # production: https://nazarai-jade.vercel.app (email links)

# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=retina-uploads
ML_SERVICE_URL=http://127.0.0.1:8000           # production: https://<user>-nazarai-ml.hf.space
ML_SERVICE_API_KEY=change-me-long-random-string # same value as on the ML service
ANTHROPIC_API_KEY=sk-ant-...                    # optional: without it, fixed-template reports are used
ANTHROPIC_MODEL=claude-opus-5-5
# Development only: show results from the UNTRAINED pipeline-test model (ignored in production builds).
ALLOW_UNTRAINED_MODEL=false
# Optional demo-clinic buttons on the sign-in page (synthetic accounts only): "Role|email|password;…"
DEMO_ACCOUNTS=
# Only for scripts/seed_demo.mjs (creates the demo clinic + one account per role)
DEMO_PASSWORD=

# ---------------------------------------------------------------- FastAPI ML service
APP_ENV=development                 # production on Hugging Face Spaces
ML_SERVICE_API_KEY=change-me-long-random-string
HF_MODEL_REPO=<user>/nazarai-dr-model   # model.onnx, model.pt, model_config.json
HF_TOKEN=hf_...                         # read token, only if the model repo is private
# MODEL_DIR=../ml/weights               # local override (e.g. ../ml/weights-dev for the pipeline-test model)
MAX_UPLOAD_MB=10
ENABLE_GRADCAM=true
